{
  "name": "gitdesk",
  "version": "0.1.0",
  "description": "A GitHub Desktop-style git client with an AI commit-message agent",
  "main": "./out/main/index.js",
  "author": "KH",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "start": "node scripts/launch.mjs preview",
    "build": "electron-vite build",
    "icons": "node scripts/make-icons.mjs",
    "dist": "npm run build && node scripts/stage-release.mjs",
    "dist:win": "npm run build && node scripts/stage-release.mjs --win",
    "dist:mac": "npm run build && node scripts/stage-release.mjs --mac",
    "dist:linux": "npm run build && node scripts/stage-release.mjs --linux",
    "dist:all": "npm run build && node scripts/stage-release.mjs --win --mac --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "git-broker": "node scripts/git-broker.mjs",
    "git-broker:status": "node scripts/git-broker.mjs --status",
    "git-broker:install": "node scripts/git-broker.mjs --install-task",
    "git-broker:uninstall": "node scripts/git-broker.mjs --uninstall-task"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@types/prismjs": "^1.26.6",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.kh.gitdesk",
    "productName": "GitDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icons/gitdesk.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "resources/icons/gitdesk.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/icons/png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
