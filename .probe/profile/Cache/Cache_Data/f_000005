const __vite__css = ":root {\r\n  --font: -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;\r\n  --mono: 'Cascadia Code', 'Consolas', 'SFMono-Regular', Menlo, monospace;\r\n}\r\n\r\n/*\r\n * Primer, played straight. This is GitHub Desktop's own color system — the\r\n * palette, the borders, the button faces and the diff washes are GitHub's\r\n * values, not an approximation of them. Roles, in GitHub's words:\r\n *\r\n *   --accent / --accent-emphasis   the single blue: links, focus, selection,\r\n *                                  the active tab, and the commit verb\r\n *   --success / --add-text         additions, staged work, success — nothing else\r\n *   --danger                       deletions, conflicts, destructive verbs\r\n *   --caution                      soft warnings you can continue past\r\n *   --ai                           the agent alone: the one accent that is\r\n *                                  allowed to be decorative\r\n *   --pull-face / --push-face      the sync verbs' own hues: amber for\r\n *                                  incoming, green for outgoing — the\r\n *                                  filled faces the Pull/Push buttons wear\r\n *\r\n * Chrome (strip, queue, tray, toolbars, status bar) is --bg-panel; the work\r\n * surface is --bg; every boundary is a 1px --border hairline.\r\n *\r\n * Two attributes drive the palette: html[data-theme-base] selects one of\r\n * the two Primer blocks below (every theme inherits its family for\r\n * anything it does not redefine), and html[data-theme] names the active\r\n * palette block — either 'light'/'dark' (no override: the base itself) or\r\n * one of the named themes further down. Both attributes are always\r\n * present. Every named block must define the full roster below; the\r\n * registry in shared/themes.ts and tests/themes.test.ts keep that honest,\r\n * along with the window-chrome colors main paints from the same values.\r\n */\r\nhtml[data-theme-base='light'] {\r\