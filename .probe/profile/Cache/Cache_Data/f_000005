----------------------------------------- progressive disclosure */\r\n/* The newcomer pass adds no new visual language: the split Sync verb is\r\n   Primer's joined-button pair, the coaching banner reuses the workflow\r\n   banner's hunk wash, the step chips are counter pills, and the tray hint\r\n   is muted status text. Every rule below reuses existing tokens only. */\r\n\r\n/* Split Sync: one verb button and its caret, joined by a single hairline. */\r\n.sync-split {\r\n  display: inline-flex;\r\n  align-items: stretch;\r\n}\r\n\r\n.sync-split .btn.sync {\r\n  border-top-right-radius: 0;\r\n  border-bottom-right-radius: 0;\r\n}\r\n\r\n.sync-split .btn.sync-caret {\r\n  border-top-left-radius: 0;\r\n  border-bottom-left-radius: 0;\r\n  border-left: none;\r\n  padding: 5px 8px;\r\n}\r\n\r\n/* A caret on a filled verb face keeps the verb's own foreground. */\r\n.sync-split .btn.sync-caret.pull .caret,\r\n.sync-split .btn.sync-caret.push .caret,\r\n.sync-split .btn.sync-caret.sync-verb .caret {\r\n  color: var(--on-accent);\r\n  opacity: 0.8;\r\n}\r\n\r\n/* Strip menus (the sync caret, the ⋯ overflow): label left, accelerator\r\n   chip right — the band dropdown's own row layout. */\r\n.strip-menu .popover-item {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n}\r\n\r\n.strip-menu .popover-item:disabled {\r\n  color: var(--btn-disabled-ink);\r\n  cursor: default;\r\n}\r\n\r\n.strip-menu .popover-item:disabled:hover {\r\n  background: transparent;\r\n}\r\n\r\n/* The add-remote form, expanded inline inside the overflow menu. */\r\n.popover-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 6px 10px;\r\n}\r\n\r\n/* Coaching banner: workflow-banner's hunk wash, with a dismiss verb on the\r\n   heading row and numbered steps — a sequence the reader genuinely needs. */\r\n.coach-head {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space