--scroll-thumb: rgba(166, 173, 200, 0.4);\r\n  --scroll-thumb-hover: rgba(166, 173, 200, 0.7);\r\n}\r\n\r\n* {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml,\r\nbody {\r\n  margin: 0;\r\n  padding: 0;\r\n  height: 100%;\r\n}\r\n\r\nbody {\r\n  font-family: var(--font);\r\n  font-size: 13px;\r\n  color: var(--text);\r\n  background: var(--bg);\r\n  user-select: none;\r\n}\r\n\r\n#root,\r\n.app {\r\n  height: 100vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n/* ---------------------------------------------------------------- desk chrome */\r\ninput,\r\ntextarea,\r\nselect {\r\n  user-select: text;\r\n  font-family: inherit;\r\n  font-size: inherit;\r\n  color: var(--text);\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  padding: 5px 8px;\r\n  width: 100%;\r\n}\r\n\r\ninput:focus,\r\ntextarea:focus,\r\nselect:focus {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\nbutton {\r\n  font-family: inherit;\r\n}\r\n\r\n/* Primer's button: a subtle face, a 15%-ink hairline, a 1px lift shadow, and\r\n   nothing else. Hover changes the color, never the position. */\r\n.btn {\r\n  border: 1px solid var(--btn-border);\r\n  background: var(--btn-bg);\r\n  color: var(--text);\r\n  border-radius: 6px;\r\n  padding: 5px 12px;\r\n  box-shadow: var(--btn-shadow);\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.btn:hover:not(:disabled) {\r\n  background: var(--btn-bg-hover);\r\n  border-color: var(--btn-border-hover);\r\n}\r\n\r\n/* Pressed: GitHub Desktop's buttons darken one step and stay put. */\r\n.btn:active:not(:disabled) {\r\n  background: var(--btn-bg-active);\r\n}\r\n\r\n.btn:disabled {\r\n  color: var(--btn-disabled-ink);\r\n  background: var(--btn-disabled-bg);\r\n  box-shadow: none;\r\n  cursor: default;\r\n}\r\n\r\n.btn:focus-visible {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\n/* The commit verb: GitHub's accent-emphasis button. The blue carries the app's\r\n   one loud action; green is left to the git facts it produces. */\r\n.btn.primary {\r\n  background: var(--primary);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.btn.primary:hover:not(:disabled) {\r\n  background: var(--primary-hover);\r\n  border-color: var(--btn-border);\r\n}\r\n\r\n.btn.primary:active:not(:disabled) {\r\n  background: var(--accent-active);\r\n}\r\n\r\n/* A confirmation that throws work away answers in Alarm Red: the blue verb\r\n   always means something was kept, never that something was lost. */\r\n.btn.primary.destructive {\r\n  background: var(--danger-face);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.btn.primary.destructive:hover:not(:disabled) {\r\n  background: var(--danger-face-hover);\r\n}\r\n\r\n.btn.primary.destructive:active:not(:disabled) {\r\n  background: var(--danger-face-hover);\r\n}\r\n\r\n/* A filled verb keeps its label readable at full strength; an unavailable\r\n   commit takes Primer's disabled face instead of a washed-out hue. */\r\n.btn.primary:disabled {\r\n  background: var(--btn-disabled-bg);\r\n  border-color: var(--btn-border);\r\n  color: var(--btn-disabled-ink);\r\n}\r\n\r\n/* The AI agent's own signature: Primer's done-purple — the one accent in the\r\n   system that is allowed to be decorative, so the machine that writes your\r\n   message for you reads as the different machine in the room. */\r\n.btn.ai {\r\n  background: var(--ai-face);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n  /* The sparkle is a letterform in the label's own white, not a gold emoji: a\r\n     color with no role may not ride in on a glyph. */\r\n  font-variant-emoji: text;\r\n}\r\n\r\n.btn.ai:hover:not(:disabled) {\r\n  background: var(--ai-face-hover);\r\n  border-color: var(--btn-border);\r\n}\r\n\r\n/* The sync verbs keep their own hue so the desk reads by color alone:\r\n   green is outgoing — the push adds to the remote, the same green the\r\n   diff gives additions — and amber is incoming, a pull that will touch\r\n   your working tree and worth a second of caution. Blue stays the\r\n   commit verb's own; fetch, which changes nothing locally, stays a\r\n   neutral button. */\r\n.btn.pull {\r\n  background: var(--pull-face);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.btn.pull:hover:not(:disabled) {\r\n  background: var(--pull-face-hover);\r\n  border-color: var(--btn-border);\r\n}\r\n\r\n.btn.push {\r\n  background: var(--push-face);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.btn.push:hover:not(:disabled) {\r\n  background: var(--push-face-hover);\r\n  border-color: var(--btn-border);\r\n}\r\n\r\n/* A filled verb that is unavailable takes Primer's disabled face, exactly\r\n   like the commit button: grayed means grayed the same way everywhere. */\r\n.btn.pull:disabled,\r\n.btn.push:disabled {\r\n  background: var(--btn-disabled-bg);\r\n  border-color: var(--btn-border);\r\n  color: var(--btn-disabled-ink);\r\n}\r\n\r\n/* The compound Pull & Push verb wears Push Green: what the user aimed for\r\n   is the push, the pull is the road there — the ↓/↑ count pills on the\r\n   label carry the incoming half's amber caution themselves, so the face\r\n   stays one hue (the desk reads by colour alone; two gradients would say\r\n   nothing legible). */\r\n.btn.sync-verb {\r\n  background: var(--push-face);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.btn.sync-verb:hover:not(:disabled) {\r\n  background: var(--push-face-hover);\r\n  border-color: var(--btn-border);\r\n}\r\n\r\n.btn.sync-verb:disabled {\r\n  background: var(--btn-disabled-bg);\r\n  border-color: var(--btn-border);\r\n  color: var(--btn-disabled-ink);\r\n}\r\n\r\n.icon-btn {\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--text-muted);\r\n  font-size: 16px;\r\n  cursor: pointer;\r\n}\r\n\r\n.mini {\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--accent);\r\n  cursor: pointer;\r\n  font-size: 12px;\r\n  padding: 2px 4px;\r\n}\r\n\r\n.mini:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.link {\r\n  background: none;\r\n  border: none;\r\n  color: var(--accent);\r\n  cursor: pointer;\r\n  padding: 0;\r\n}\r\n\r\n/* ---------------------------------------------------------------- header */\r\n\r\n/* GitHub Desktop's toolbar: the same subtle chrome as the queue and the tray,\r\n   held off the work by one hairline. The strip is not tinted per desk; the\r\n   active tab and the verb's color say what GitHub Desktop's says. */\r\n.header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 6px 10px;\r\n  background: var(--bg-panel);\r\n  border-bottom: 1px solid var(--border);\r\n  flex: 0 0 auto;\r\n}\r\n\r\n/*\r\n * Window frame, Windows: main hides the OS title bar and floats the\r\n * caption buttons in a Window Controls Overlay painted from --bg-header\r\n * (src/main/windows.ts). The title band below is the window's drag\r\n * handle and the overlay's ground — a quiet strip all its own, so the\r\n * command bar beneath stays 100% clickable and Min/Max/Close never sit\r\n * on top of an app button. Its height must equal titleBarHeight in\r\n * src/main/windows.ts so the caption buttons and the band end on the\r\n * same line. The paddings follow the caption safe area through\r\n * env(titlebar-area-*), which also covers left-side buttons (RTL /\r\n * some Linux setups); without the overlay (data-wco unset) the band is\r\n * display:none and the layout is exactly the old one.\r\n */\r\n.titlebar {\r\n  display: none;\r\n}\r\n\r\nhtml[data-wco] .titlebar {\r\n  display: flex;\r\n  align-items: center;\r\n  flex: 0 0 auto;\r\n  height: 40px; /* matches titleBarHeight in src/main/windows.ts */\r\n  -webkit-app-region: drag;\r\n  background: var(--bg-header);\r\n  padding-left: calc(12px + env(titlebar-area-x, 0px));\r\n  padding-right: calc(\r\n    12px + 100vw - env(titlebar-area-x, 0px) - env(titlebar-area-width, 100vw)\r\n  );\r\n}\r\n\r\n.titlebar-label {\r\n  font-size: 12px;\r\n  font-weight: 600;\r\n  letter-spacing: 0.01em;\r\n  color: var(--text);\r\n  white-space: nowrap;\r\n}\r\n\r\n/* The desktop mark (resources/aspen-icon.svg) leading the wordmark — the\r\n   same asset the taskbar button and tray use, so the window reads as the\r\n   app at a glance. */\r\n.titlebar-logo {\r\n  width: 16px;\r\n  height: 16px;\r\n  margin-right: 7px;\r\n  display: block;\r\n  -webkit-user-drag: none;\r\n}\r\n\r\n/*\r\n * The band's menu labels: same template the classic menu bar uses, popped\r\n * as native menus by main (src/main/menu.ts popupMenuAt). Draggable\r\n * regions swallow pointer events, so they explicitly opt back out.\r\n */\r\n.titlebar-menu {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  margin-left: 8px;\r\n}\r\n\r\n.titlebar-item {\r\n  -webkit-app-region: no-drag;\r\n  font: inherit;\r\n  font-size: 12px;\r\n  color: var(--text);\r\n  background: transparent;\r\n  border: 0;\r\n  border-radius: 4px;\r\n  padding: 3px 8px;\r\n  cursor: default;\r\n  white-space: nowrap;\r\n}\r\n\r\n.titlebar-item:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.titlebar-item[aria-expanded='true'] {\r\n  background: var(--bg-active, var(--bg-hover));\r\n  color: var(--accent);\r\n}\r\n\r\n/*\r\n * Right-aligned shortcut hint for the band's dropdowns (ContextMenu\r\n * carries the accelerator span). Row layout applies only inside\r\n * .context-menu, so the app's other popover items are untouched.\r\n */\r\n.context-menu .popover-item {\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 24px;\r\n}\r\n\r\n.menu-accel {\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.header-left,\r\n.header-right {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.strip-center {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  justify-content: center;\r\n  min-width: 0;\r\n  padding: 0 10px;\r\n}\r\n\r\n.strip-filter {\r\n  width: min(460px, 100%);\r\n  min-width: 120px;\r\n  font-size: 12px;\r\n}\r\n\r\n/* The visible Ctrl K affordance, riding inside the strip filter's right edge. */\r\n.kbd-hint {\r\n  margin-left: -64px;\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  color: var(--text-muted);\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  padding: 0 5px;\r\n  line-height: 16px;\r\n  pointer-events: none;\r\n  align-self: center;\r\n}\r\n\r\n.route-readout {\r\n  font-family: var(--mono);\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n  padding: 0 4px;\r\n  cursor: default;\r\n}\r\n\r\n.route-readout .route-arrow {\r\n  color: var(--accent);\r\n}\r\n\r\n.picker {\r\n  min-width: 180px;\r\n  text-align: left;\r\n  justify-content: space-between;\r\n}\r\n\r\n.picker-label {\r\n  display: flex;\r\n  flex-direction: column;\r\n  line-height: 1.25;\r\n  overflow: hidden;\r\n}\r\n\r\n.picker-label small {\r\n  color: var(--text-muted);\r\n  font-size: 10.5px;\r\n}\r\n\r\n.picker-label strong {\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 220px;\r\n}\r\n\r\n.caret {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.hint {\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.menu-wrap {\r\n  position: relative;\r\n}\r\n\r\n.popover {\r\n  position: absolute;\r\n  top: calc(100% + 4px);\r\n  left: 0;\r\n  z-index: 50;\r\n  min-width: 320px;\r\n  max-height: 480px;\r\n  overflow-y: auto;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  box-shadow: var(--shadow);\r\n  padding: 4px;\r\n}\r\n\r\n.popover-item {\r\n  display: flex;\r\n  flex-direction: column;\r\n  width: 100%;\r\n  text-align: left;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--text);\r\n  padding: 7px 10px;\r\n  border-radius: 6px;\r\n  cursor: pointer;\r\n}\r\n\r\n.popover-item:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.popover-item.active {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n/* Keyboard cursor in the popovers' pickers (the repository switcher): the same\r\n   inset accent border the repository hub uses, so the pointer's hover ground\r\n   and the keys' ring stay two separate answers — and the ring can sit on the\r\n   already-active row without hiding it. */\r\n.popover-item.cursor {\r\n  outline: 1px solid var(--accent);\r\n  outline-offset: -3px;\r\n}\r\n\r\n.popover-item.danger {\r\n  color: var(--danger);\r\n}\r\n\r\n.popover-path {\r\n  color: var(--text-muted);\r\n  font-weight: 400;\r\n  font-size: 11px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n/* Branch rows: name on the left, ↑/↓ divergence badges pushed to the\r\n   right edge. `.popover-item` is a flex column, so the badge shares a\r\n   line with the name inside this wrapper. */\r\n.branch-line {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n/* Machine-truth cell (like the ahead/behind counts in the header and the\r\n   repository manager): tabular digits, muted color; the tooltip carries\r\n   the full sentence. */\r\n.branch-div {\r\n  flex: 0 0 auto;\r\n  margin-left: auto;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 400;\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* The vs-upstream badge reads as secondary to the vs-current one. */\r\n.branch-div.upstream {\r\n  opacity: 0.65;\r\n}\r\n\r\n.popover-empty {\r\n  padding: 10px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.popover-sep {\r\n  height: 1px;\r\n  background: var(--border);\r\n  margin: 4px 0;\r\n}\r\n\r\n.popover-filter {\r\n  margin: 4px;\r\n  width: calc(100% - 8px);\r\n}\r\n\r\n/* The repository switcher's filter row: the field flexes beside the Add\r\n   disclosure. The override is scoped to the row, so every bare .popover-filter\r\n   (the branch picker, the add-remote form, the dialogs) keeps its full-width\r\n   face untouched. */\r\n.popover-filter-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  margin: 4px;\r\n}\r\n\r\n.popover-filter-row .popover-filter {\r\n  flex: 1 1 auto;\r\n  width: auto;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n\r\n.popover-add {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n/* The Add menu: an inline disclosure between the filter row and the list, so\r\n   the popover's own scroll box never clips a floating sub-menu. Same surface\r\n   language as .popover — border, shadow, item rows ride the base styles. */\r\n.repo-add-menu {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  margin: 0 4px 4px;\r\n  padding: 4px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  box-shadow: var(--shadow);\r\n}\r\n\r\n/* ---------------------------------------------------------------- layout */\r\n\r\n.body {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  min-height: 0;\r\n}\r\n\r\n/* The desk's two docked panels size from these variables so dragging the\r\n   divider between them retunes the layout without touching any rule; the\r\n   inline value a user drag writes on .work-area wins over the narrow-desk\r\n   media query below, which is the point — explicit intent beats breakpoint. */\r\n.work-area {\r\n  --queue-w: 340px;\r\n  --tray-w: 300px;\r\n}\r\n\r\n.queue-col {\r\n  flex: 0 0 var(--queue-w);\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  border-right: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  min-height: 0;\r\n}\r\n\r\n.main-pane {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  display: flex;\r\n  background: var(--bg);\r\n}\r\n\r\n/* ------------------------------------------------------------ resizers */\r\n/* The draggable hairlines between the desk's zones. They sit in the flex row\r\n   but pull themselves out of the width budget with negative margins, so the\r\n   panels measure exactly as before the feature. The grip appears only on\r\n   hover, focus, or mid-drag — the boundary stays a plain hairline at rest. */\r\n\r\n.resizer {\r\n  position: relative;\r\n  flex: 0 0 5px;\r\n  margin: 0 -3px;\r\n  z-index: 6;\r\n  cursor: col-resize;\r\n  background: transparent;\r\n  border: none;\r\n  padding: 0;\r\n  touch-action: none;\r\n}\r\n\r\n.resizer::after {\r\n  content: '';\r\n  position: absolute;\r\n  inset: 0 1px;\r\n  border-radius: 2px;\r\n  background: transparent;\r\n  transition: background-color 120ms ease;\r\n}\r\n\r\n.resizer:hover::after,\r\n.resizer:focus-visible::after,\r\nbody.desk-resizing .resizer::after {\r\n  background: var(--accent);\r\n}\r\n\r\n.resizer:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n/* One gesture class on <body> so the cursor and text selection survive the\r\n   pointer racing off the 5px strip and over the diff. */\r\nbody.desk-resizing {\r\n  cursor: col-resize;\r\n  user-select: none;\r\n}\r\n\r\nbody.desk-resizing iframe,\r\nbody.desk-resizing .main-pane {\r\n  pointer-events: none;\r\n}\r\n\r\n/* ------------------------------------------------------------ desk switch */\r\n/* GitHub Desktop's segmented control: the active tab is a lifted chip on the\r\n   subtle rail, named by its label color and weight as well as the chip, so\r\n   hue is never the only signal. The chip jumps; it does not travel. */\r\n\r\n.desk-switch {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  padding: 6px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.desk-tab {\r\n  position: relative;\r\n  z-index: 1;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 12px;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  background: transparent;\r\n  color: var(--text-muted);\r\n  font: inherit;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n\r\n.desk-tab:hover {\r\n  background: var(--bg-hover);\r\n  color: var(--text);\r\n}\r\n\r\n.desk-tab.active {\r\n  color: var(--accent);\r\n  font-weight: 600;\r\n}\r\n\r\n.desk-tab:focus-visible {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\n/* Primer's counter: a bordered pill on the canvas, never a tinted blob. */\r\n.tab-badge {\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  line-height: 1;\r\n  padding: 2px 6px;\r\n  border-radius: 999px;\r\n  background: var(--bg);\r\n  border: 1px solid var(--btn-border);\r\n  color: var(--text-muted);\r\n}\r\n\r\n.desk-tab.active .tab-badge {\r\n  background: var(--chip-face);\r\n  border-color: color-mix(in srgb, var(--accent) 40%, transparent);\r\n  color: var(--accent);\r\n}\r\n\r\n.tab-badge.danger,\r\n.desk-tab.danger .tab-badge {\r\n  color: var(--danger);\r\n  border-color: color-mix(in srgb, var(--danger) 45%, var(--border));\r\n}\r\n\r\n/* Conflicts waiting: the label itself goes alarm-red wherever you are sitting,\r\n   so the interruption is legible before the badge count is read. */\r\n.desk-tab.danger {\r\n  color: color-mix(in srgb, var(--danger) 75%, var(--text-muted));\r\n}\r\n\r\n.desk-tab.danger:hover {\r\n  color: var(--danger);\r\n}\r\n\r\n.queue-label {\r\n  padding: 8px 10px 3px;\r\n  font-size: 10.5px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.queue-label b {\r\n  font-family: var(--mono);\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.filter-meta {\r\n  padding: 6px 10px;\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  text-align: center;\r\n}\r\n\r\n/* ---------------------------------------------------------------- changes */\r\n\r\n.changes-list {\r\n  flex: 1 1 auto;\r\n  overflow-y: auto;\r\n  min-height: 0;\r\n}\r\n\r\n.changes-toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 6px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  position: sticky;\r\n  top: 0;\r\n  /* Rows are position: relative and later in the DOM, so without a z-index\r\n     they paint over this bar while it sticks during scroll. */\r\n  z-index: 1;\r\n  background: var(--bg-panel);\r\n}\r\n\r\n.select-all {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.select-all input {\r\n  width: auto;\r\n}\r\n\r\n.sidebar-message {\r\n  padding: 32px 20px;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.sidebar-message.error strong {\r\n  color: var(--danger);\r\n  display: block;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.sidebar-message p {\r\n  white-space: pre-wrap;\r\n  user-select: text;\r\n  font-size: 12px;\r\n}\r\n\r\n.file-row {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 7px;\r\n  padding: 5px 10px;\r\n  cursor: pointer;\r\n  border-bottom: 1px solid transparent;\r\n}\r\n\r\n/* GitHub Desktop names a file by its status symbol, never by a colored rail:\r\n   the symbol already says what changed, so the row needs no second signal. */\r\n\r\n.file-row:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n/* A selected row inverts to white on GitHub's accent, exactly as GitHub\r\n   Desktop's lists do. State survives the inversion because the mark is a\r\n   distinct symbol, not a hue. */\r\n.file-row.selected {\r\n  background: var(--bg-selected);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.file-row.selected:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.file-row.selected .file-dir {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n.file-row.selected .status-glyph {\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.file-row.selected .badge {\r\n  color: var(--row-on-accent);\r\n  background: var(--on-accent-chip);\r\n  border-color: var(--on-accent-chip-border);\r\n}\r\n\r\n.file-row.conflicted:not(.selected) {\r\n  color: var(--danger);\r\n}\r\n\r\n/* Staging is committing, so the box answers in GitHub's green while every\r\n   other control in the app answers in the interaction blue. */\r\n.file-row input[type='checkbox'] {\r\n  width: auto;\r\n  flex: 0 0 auto;\r\n  accent-color: var(--success);\r\n}\r\n\r\n.file-row.compact {\r\n  padding: 4px 8px;\r\n}\r\n\r\n.status-glyph {\r\n  flex: 0 0 14px;\r\n  text-align: center;\r\n  font-size: 11px;\r\n}\r\n\r\n.status-glyph.new {\r\n  color: var(--add-text);\r\n}\r\n\r\n.status-glyph.deleted {\r\n  color: var(--del-text);\r\n}\r\n\r\n.status-glyph.conflicted {\r\n  color: var(--danger);\r\n  font-weight: 700;\r\n}\r\n\r\n.status-glyph.renamed,\r\n.status-glyph.copied {\r\n  color: var(--hunk-text);\r\n}\r\n\r\n.status-glyph.modified,\r\n.status-glyph.type-changed {\r\n  color: var(--caution);\r\n}\r\n\r\n.file-path {\r\n  flex: 1 1 auto;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  min-width: 0;\r\n}\r\n\r\n.file-dir {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.file-name {\r\n  font-weight: 600;\r\n}\r\n\r\n/* ---------------------------------------------------------------- scripts */\r\n\r\n/* The Scripts desk's queue rows: one Run button, the script name, and the\r\n   command it runs — the same two-line idiom the file rows use, where the\r\n   muted line is context rather than state. */\r\n.script-row {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 5px 10px;\r\n  border-bottom: 1px solid transparent;\r\n}\r\n\r\n.script-row:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.script-row .run {\r\n  flex: 0 0 auto;\r\n  min-width: 26px;\r\n}\r\n\r\n.script-info {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n  min-width: 0;\r\n}\r\n\r\n.script-name {\r\n  font-weight: 600;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.script-command {\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* The lockfile-detected manager, shown once in the section head so every\r\n   row's typed command is honest about which verb ▶ presses. */\r\n.script-manager {\r\n  margin-left: 8px;\r\n  font-family: var(--mono);\r\n  text-transform: none;\r\n  color: var(--text);\r\n  background: var(--bg-header);\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  padding: 0 6px;\r\n}\r\n\r\n.script-hint {\r\n  padding: 8px 10px;\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.badge {\r\n  flex: 0 0 auto;\r\n  font-size: 10.5px;\r\n  padding: 1px 6px;\r\n  border-radius: 999px;\r\n  background: var(--bg-header);\r\n  color: var(--text-muted);\r\n  border: 1px solid var(--border);\r\n}\r\n\r\n.badge.staged {\r\n  color: var(--add-text);\r\n  border-color: color-mix(in srgb, var(--add-text) 45%, var(--border));\r\n  background: color-mix(in srgb, var(--add-text) 12%, transparent);\r\n  cursor: pointer;\r\n  font-family: inherit;\r\n}\r\n\r\n.badge.unstaged {\r\n  cursor: default;\r\n}\r\n\r\n.discard {\r\n  opacity: 0;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.file-row:hover .discard {\r\n  opacity: 1;\r\n}\r\n\r\n/* Discard is a decision, so the × says so in GitHub's red and nothing else. */\r\n.discard:hover {\r\n  color: var(--danger);\r\n}\r\n\r\n/* ------------------------------------------------------------ commit tray */\r\n\r\n.commit-tray {\r\n  flex: 0 0 var(--tray-w);\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 10px;\r\n  border-left: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n}\r\n\r\n.scope-line {\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  color: var(--text-muted);\r\n  cursor: help;\r\n}\r\n\r\n.scope-line b {\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n\r\n/* The numbers in the scope line are git truth, so they speak the diff's own\r\n   colors — green for what ships as additions, red for deletions. */\r\n.scope-adds {\r\n  color: var(--add-text);\r\n}\r\n\r\n.scope-dels {\r\n  color: var(--del-text);\r\n}\r\n\r\n.commit-tray .commit-actions {\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n}\r\n\r\n.commit-tray .commit-actions .btn.ai {\r\n  justify-content: center;\r\n}\r\n\r\n.commit-tray .commit-actions .btn.push {\r\n  justify-content: center;\r\n}\r\n\r\n.commit-field {\r\n  position: relative;\r\n}\r\n\r\n.summary.overlong {\r\n  border-color: var(--caution);\r\n}\r\n\r\n.length-warning {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: -18px;\r\n  font-size: 11px;\r\n  color: var(--caution);\r\n  background: var(--bg-panel);\r\n  padding: 0 4px;\r\n}\r\n\r\n.description {\r\n  resize: vertical;\r\n  min-height: 52px;\r\n}\r\n\r\n.commit-actions {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n}\r\n\r\n.commit {\r\n  flex: 1 1 auto;\r\n  justify-content: center;\r\n}\r\n\r\n.spinner {\r\n  width: 11px;\r\n  height: 11px;\r\n  border: 2px solid color-mix(in srgb, currentColor 35%, transparent);\r\n  border-top-color: currentColor;\r\n  border-radius: 50%;\r\n  display: inline-block;\r\n  animation: spin 0.8s linear infinite;\r\n}\r\n\r\n@keyframes spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n/* ------------------------------------------------- success celebration */\r\n/* The desk's one authored moment — GitHub Desktop celebrates a commit, and so\r\n   does this. When Commit or Push truly succeeds, the verb that did it pops with\r\n   a ring in Success Green (the verb itself is blue, so the ring must not be)\r\n   and sheds a brief burst of confetti tinted only with state colors. Bound to\r\n   outcomes, never idle. */\r\n\r\n.btn.celebrating {\r\n  position: relative; /* anchor for the confetti layer */\r\n  animation: btn-celebrate 500ms cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n/* A commit empties the tray, so the verb is often already disabled mid-\r\n   celebration; it keeps its face and label so the moment plays at full\r\n   strength rather than greying out under the confetti. */\r\n.btn.celebrating:disabled {\r\n  background: var(--primary);\r\n  border-color: var(--btn-border);\r\n  color: var(--on-accent);\r\n}\r\n\r\n@keyframes btn-celebrate {\r\n  0% {\r\n    transform: scale(1);\r\n    box-shadow: 0 0 0 0 color-mix(in srgb, var(--success) 60%, transparent);\r\n  }\r\n  30% {\r\n    transform: scale(1.045);\r\n  }\r\n  100% {\r\n    transform: scale(1);\r\n    box-shadow: 0 0 0 10px color-mix(in srgb, var(--success) 0%, transparent);\r\n  }\r\n}\r\n\r\n.confetti-burst {\r\n  position: absolute;\r\n  inset: 0;\r\n  overflow: visible;\r\n  pointer-events: none;\r\n}\r\n\r\n.confetti-bit {\r\n  position: absolute;\r\n  display: block;\r\n  transform: translate(-50%, -50%);\r\n  animation: confetti-fly 680ms cubic-bezier(0.16, 1, 0.3, 1) var(--cd, 0ms)\r\n    both;\r\n  will-change: transform, opacity;\r\n}\r\n\r\n@keyframes confetti-fly {\r\n  0% {\r\n    transform: translate(-50%, -50%) scale(0.3);\r\n    opacity: 0;\r\n  }\r\n  14% {\r\n    transform: translate(-50%, -50%) scale(1) rotate(calc(var(--cr, 0deg) * 0.1));\r\n    opacity: 1;\r\n  }\r\n  100% {\r\n    transform: translate(calc(-50% + var(--cx, 0px)), calc(-50% + var(--cy, 0px)))\r\n      scale(0.7) rotate(var(--cr, 0deg));\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  /* No flight, no pop — the success ring still fires so the outcome stays\r\n     legible, and the confetti fades in place instead of launching. */\r\n  .btn.celebrating {\r\n    animation: btn-celebrate-quiet 500ms ease-out;\r\n  }\r\n\r\n  @keyframes btn-celebrate-quiet {\r\n    0% {\r\n      box-shadow: 0 0 0 0 color-mix(in srgb, var(--success) 60%, transparent);\r\n    }\r\n    100% {\r\n      box-shadow: 0 0 0 8px color-mix(in srgb, var(--success) 0%, transparent);\r\n    }\r\n  }\r\n\r\n  .confetti-bit {\r\n    animation: confetti-fade 420ms ease-out var(--cd, 0ms) both;\r\n  }\r\n\r\n  @keyframes confetti-fade {\r\n    from {\r\n      opacity: 1;\r\n    }\r\n    to {\r\n      opacity: 0;\r\n    }\r\n  }\r\n}\r\n\r\n/* ----------------------------------------------- the verbs arm themselves */\r\n/* The desk's story is compose → commit → push, and the story advances at the\r\n   moment a verb flips from “cannot” to “can”: checking the first file arms\r\n   Commit; a landed commit turns ahead 0 → n and arms Push — the baton pass at\r\n   the far end of the celebration, where the green ring on the verb below the\r\n   confetti reads as “and now, the next move”. That flip is the app pointing at\r\n   the user's action, so the button throws exactly one short ring in its own\r\n   hue (the focus-ring family, per-verb colored like its face). Bound to state\r\n   transitions; it never loops and never fires on first paint. */\r\n\r\n.btn.commit.arming,\r\n.btn.push.arming {\r\n  animation: btn-arm 400ms var(--ease-arrive);\r\n}\r\n\r\n.btn.commit.arming {\r\n  --arm-ring: var(--primary);\r\n}\r\n\r\n.btn.push.arming {\r\n  --arm-ring: var(--push-face);\r\n}\r\n\r\n@keyframes btn-arm {\r\n  0% {\r\n    transform: scale(0.99);\r\n    box-shadow: 0 0 0 0 color-mix(in srgb, var(--arm-ring) 55%, transparent);\r\n  }\r\n  40% {\r\n    transform: scale(1.02);\r\n  }\r\n  100% {\r\n    transform: scale(1);\r\n    box-shadow: 0 0 0 9px color-mix(in srgb, var(--arm-ring) 0%, transparent);\r\n  }\r\n}\r\n\r\n/* Press: the two completing verbs answer the click with a hair of scale —\r\n   commitment, the same family as their celebration pop, a quarter of its\r\n   size. Every other control in the app still darkens one step and stays put. */\r\n.btn.commit:active:not(:disabled),\r\n.btn.push:active:not(:disabled) {\r\n  transform: scale(0.97);\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  /* The arm ring is state feedback, so it keeps its bloom and loses only the\r\n     swell; the press commit loses its scale and keeps its color step. */\r\n  .btn.commit.arming,\r\n  .btn.push.arming {\r\n    animation: btn-arm-quiet 400ms ease-out;\r\n  }\r\n\r\n  @keyframes btn-arm-quiet {\r\n    0% {\r\n      box-shadow: 0 0 0 0 color-mix(in srgb, var(--arm-ring) 55%, transparent);\r\n    }\r\n    100% {\r\n      box-shadow: 0 0 0 7px color-mix(in srgb, var(--arm-ring) 0%, transparent);\r\n    }\r\n  }\r\n\r\n  .btn.commit:active:not(:disabled),\r\n  .btn.push:active:not(:disabled) {\r\n    transform: none;\r\n  }\r\n}\r\n\r\n/* ---------------------------------------------------------------- motion */\r\n/* Aspen moves the way GitHub Desktop moves: almost not at all. Controls\r\n   answer the cursor with color alone — the two completing verbs alone aside,\r\n   which press on a hair of scale and arm on a ring — floated layers fade in at\r\n   a hair of scale, the desk swap fades the incoming pane in, a running\r\n   operation spins, and a commit or push that lands throws confetti. Nothing\r\n   lifts, travels, staggers or pops. Three tiers — 90/140/200 ms — and the one\r\n   long celebration. */\r\n\r\n:root {\r\n  --motion-instant: 90ms;\r\n  --motion-fast: 140ms;\r\n  --motion-layer: 200ms;\r\n  --ease-arrive: cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\n/* --- controls answer the cursor, in color alone -------------------------- */\r\n\r\n.btn {\r\n  transition:\r\n    background-color var(--motion-instant) ease-out,\r\n    border-color var(--motion-instant) ease-out,\r\n    color var(--motion-instant) ease-out,\r\n    box-shadow var(--motion-instant) ease-out,\r\n    transform var(--motion-instant) ease-out;\r\n}\r\n\r\n/* Hover and press answer with color alone, the way GitHub Desktop's buttons\r\n   do: a control in a toolbar never moves out of its row. The two completing\r\n   verbs are the one exception below — press is the desk's most repeated\r\n   gesture, and they answer it with a hair of commitment. */\r\n\r\n.icon-btn,\r\n.mini,\r\n.link {\r\n  transition: color var(--motion-instant) ease-out;\r\n}\r\n\r\n.icon-btn:hover:not(:disabled) {\r\n  background: var(--bg-hover);\r\n  color: var(--text);\r\n}\r\n\r\n.desk-tab {\r\n  transition:\r\n    background-color var(--motion-fast) ease-out,\r\n    border-color var(--motion-fast) ease-out,\r\n    color var(--motion-fast) ease-out;\r\n}\r\n\r\n/* The selected-tab chip, positioned in App.tsx by --tab-x/--tab-w. It jumps to\r\n   the active tab — GitHub Desktop has no travelling selection, so only its\r\n   arrival is acknowledged, never a journey. */\r\n.desk-indicator {\r\n  position: absolute;\r\n  z-index: 0;\r\n  top: 6px;\r\n  left: 0;\r\n  height: calc(100% - 12px);\r\n  width: var(--tab-w, 1px);\r\n  border-radius: 6px;\r\n  background: var(--chip-face);\r\n  border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);\r\n  box-shadow: var(--btn-shadow);\r\n  transform: translateX(var(--tab-x, 0px));\r\n  opacity: 0;\r\n  pointer-events: none;\r\n  transition: opacity var(--motion-fast) ease-out;\r\n}\r\n\r\n.desk-indicator.shown {\r\n  opacity: 1;\r\n}\r\n\r\ninput,\r\ntextarea,\r\nselect {\r\n  transition:\r\n    border-color var(--motion-instant) ease-out,\r\n    box-shadow var(--motion-instant) ease-out;\r\n}\r\n\r\n.file-row,\r\n.commit-row,\r\n.stash-row,\r\n.popover-item,\r\n.recent-repo {\r\n  transition:\r\n    background-color var(--motion-instant) ease-out,\r\n    border-color var(--motion-instant) ease-out,\r\n    color var(--motion-instant) ease-out;\r\n}\r\n\r\n.discard {\r\n  transition:\r\n    opacity var(--motion-fast) ease-out,\r\n    color var(--motion-instant) ease-out;\r\n}\r\n\r\n/* --- floated layers arrive, never blink in ------------------------------ */\r\n\r\n@keyframes layer-in {\r\n  from {\r\n    opacity: 0;\r\n    transform: scale(0.98);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n@keyframes scrim-in {\r\n  from {\r\n    opacity: 0;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes dialog-in {\r\n  from {\r\n    opacity: 0;\r\n    transform: scale(0.98);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n@keyframes toast-in {\r\n  from {\r\n    opacity: 0;\r\n    transform: scale(0.98);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n.popover {\r\n  animation: layer-in var(--motion-fast) var(--ease-arrive) both;\r\n  transform-origin: top left;\r\n}\r\n\r\n/* Right-cluster popovers (the strip's \"Open in\" menu) hang from their own\r\n   right edge so they open inward and never clip off-screen; the repo/branch\r\n   pickers on the left keep the base left alignment. */\r\n.header-right .popover {\r\n  left: auto;\r\n  right: 0;\r\n  min-width: 240px;\r\n  transform-origin: top right;\r\n}\r\n\r\n.context-menu {\r\n  /* `backwards`, never `both`: a filled animation on `transform` keeps the\r\n     element's transform flag on permanently (an identity matrix), which makes\r\n     the menu the containing block for its fixed-position submenu and clips it\r\n     inside the menu's own overflow. `backwards` still prevents the first-frame\r\n     flash but releases the transform once the entry animation finishes. */\r\n  animation: layer-in var(--motion-fast) var(--ease-arrive) backwards;\r\n  transform-origin: top left;\r\n}\r\n\r\n.dialog-overlay {\r\n  animation: scrim-in var(--motion-fast) ease-out both;\r\n}\r\n\r\n.dialog {\r\n  animation: dialog-in var(--motion-layer) var(--ease-arrive) both;\r\n}\r\n\r\n.toast {\r\n  animation: toast-in var(--motion-layer) var(--ease-arrive) both;\r\n}\r\n\r\n/* --- the desk view swap -------------------------------------------------- */\r\n\r\n/* GitHub Desktop's lists do not animate their rows in: a newly changed file is\r\n   simply there. The desk swap is exactly one fade, on the two regions that\r\n   actually change — the queue and the main pane, keyed on the view so it replays\r\n   once per switch. The strip, tab rail, tray and status bar are the same faces\r\n   in every desk, so they are never animated: nothing that did not change is\r\n   allowed to move, which is what made the old whole-window snapshot shimmer. */\r\n.pane-enter {\r\n  animation: scrim-in var(--motion-fast) ease-out both;\r\n}\r\n\r\n/* Ahead/behind counts simply read differently when they change: GitHub Desktop\r\n   never bounces a number to tell you it moved. */\r\n.count-pop {\r\n  display: inline-block;\r\n}\r\n\r\n.empty-state {\r\n  animation: scrim-in var(--motion-fast) ease-out both;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  /* Nothing travels in this world to begin with: the fades, the chip's\r\n     arrival, and the spinner are all the motion there is, and all of them\r\n     stay. */\r\n  .popover,\r\n  .context-menu,\r\n  .dialog,\r\n  .toast,\r\n  .pane-enter,\r\n  .empty-state {\r\n    animation-name: scrim-in;\r\n  }\r\n\r\n  .discard {\r\n    transition: none;\r\n  }\r\n}\r\n\r\n/* ---------------------------------------------------------------- diff */\r\n\r\n.diff-view {\r\n  flex: 1 1 auto;\r\n  overflow: auto;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.diff-view.empty-diff,\r\n.empty-state {\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  color: var(--text-muted);\r\n  padding: 40px;\r\n  /* GitHub Desktop's empty pane is plain canvas with centered guidance: the\r\n     heading that names the pane is ink, and only the guidance is muted. */\r\n  background: var(--bg);\r\n}\r\n\r\n.empty-state h2 {\r\n  color: var(--text);\r\n}\r\n\r\n.diff-title {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  font-family: var(--mono);\r\n  padding: 6px 12px;\r\n  background: var(--bg-header);\r\n  border-bottom: 1px solid var(--border);\r\n  font-size: 12px;\r\n}\r\n\r\n.diff-table {\r\n  border-collapse: collapse;\r\n  width: 100%;\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  line-height: 1.55;\r\n  table-layout: auto;\r\n}\r\n\r\n/* A new file's diff arrives rather than appearing mid-scroll — the whole table\r\n   fades as one layer so a thousand-row diff costs one composited animation. */\r\n.diff-view .diff-table {\r\n  animation: scrim-in var(--motion-fast) ease-out both;\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .diff-view .diff-table {\r\n    animation: none;\r\n  }\r\n}\r\n\r\n.diff-line.add {\r\n  background: var(--add-bg);\r\n}\r\n\r\n.diff-line.add .lineno {\r\n  background: var(--add-gutter);\r\n  color: var(--add-text);\r\n}\r\n\r\n.diff-line.del {\r\n  background: var(--del-bg);\r\n}\r\n\r\n.diff-line.del .lineno {\r\n  background: var(--del-gutter);\r\n  color: var(--del-text);\r\n}\r\n\r\n.diff-line.hunk {\r\n  background: var(--hunk-bg);\r\n}\r\n\r\n.diff-line.hunk .lineno {\r\n  background: var(--hunk-gutter);\r\n}\r\n\r\n.diff-line.hunk .content {\r\n  color: var(--hunk-text);\r\n}\r\n\r\n.diff-line.meta .content {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.diff-line.warning .content {\r\n  color: var(--caution);\r\n}\r\n\r\n.lineno {\r\n  width: 44px;\r\n  min-width: 44px;\r\n  text-align: right;\r\n  padding: 0 8px;\r\n  color: var(--text-muted);\r\n  user-select: none;\r\n  border-right: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  font-size: 11px;\r\n  vertical-align: top;\r\n  white-space: nowrap;\r\n}\r\n\r\n.diff-line.add .lineno:last-of-type {\r\n  color: var(--add-text);\r\n}\r\n\r\n.diff-line.del .lineno:first-of-type {\r\n  color: var(--del-text);\r\n}\r\n\r\n.sign {\r\n  width: 16px;\r\n  min-width: 16px;\r\n  text-align: center;\r\n  user-select: none;\r\n  color: var(--text-muted);\r\n  vertical-align: top;\r\n}\r\n\r\n.diff-line.add .sign {\r\n  color: var(--add-text);\r\n}\r\n\r\n.diff-line.del .sign {\r\n  color: var(--del-text);\r\n}\r\n\r\n.content {\r\n  padding: 0 10px;\r\n  white-space: pre-wrap;\r\n  word-break: break-all;\r\n  user-select: text;\r\n  vertical-align: top;\r\n}\r\n\r\n/* prism token colors (theme-agnostic-ish) */\r\n.content .token.comment,\r\n.content .token.prolog,\r\n.content .token.cdata {\r\n  color: var(--syntax-comment);\r\n  font-style: italic;\r\n}\r\n\r\n.content .token.keyword,\r\n.content .token.boolean {\r\n  color: var(--syntax-keyword);\r\n}\r\n\r\n.content .token.string,\r\n.content .token.char,\r\n.content .token.regex {\r\n  color: var(--syntax-string);\r\n}\r\n\r\n.content .token.number {\r\n  color: var(--syntax-constant);\r\n}\r\n\r\n.content .token.function {\r\n  color: var(--syntax-function);\r\n}\r\n\r\n.content .token.class-name {\r\n  color: var(--syntax-entity);\r\n}\r\n\r\n.content .token.operator,\r\n.content .token.punctuation {\r\n  color: inherit;\r\n}\r\n\r\n.content .token.property {\r\n  color: var(--syntax-constant);\r\n}\r\n\r\n/* ---------------------------------------------------------------- history */\r\n\r\n.commit-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  padding: 8px 10px;\r\n  border-bottom: 1px solid var(--border);\r\n  cursor: pointer;\r\n  align-items: flex-start;\r\n}\r\n\r\n.commit-row:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.commit-row.selected {\r\n  background: var(--bg-selected);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.commit-row.selected:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.commit-row.selected .commit-meta {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n.commit-row.selected .badge {\r\n  color: var(--row-on-accent);\r\n  background: var(--on-accent-chip);\r\n  border-color: var(--on-accent-chip-border);\r\n}\r\n\r\n/* Avatars are GitHub's neutral discs: the initials stand in for a fetched\r\n   photo, and nothing about them competes with the commit subject. */\r\n.avatar {\r\n  flex: 0 0 24px;\r\n  height: 24px;\r\n  border-radius: 50%;\r\n  background: var(--bg-inset);\r\n  color: var(--text-muted);\r\n  font-size: 10.5px;\r\n  font-weight: 700;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.commit-row.selected .avatar {\r\n  background: var(--on-accent-chip);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.commit-summary {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  word-break: break-word;\r\n  display: flex;\r\n  gap: 6px;\r\n  align-items: center;\r\n}\r\n\r\n.commit-meta {\r\n  flex: 0 0 auto;\r\n  text-align: right;\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  line-height: 1.3;\r\n  font-family: var(--mono);\r\n}\r\n\r\n.history-view {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n}\r\n\r\n.commit-detail {\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n}\r\n\r\n.commit-detail-head {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.commit-detail-meta {\r\n  color: var(--text-muted);\r\n  margin-top: 4px;\r\n  font-size: 12px;\r\n  font-family: var(--mono);\r\n}\r\n\r\n.commit-detail-body {\r\n  margin: 8px 0 0;\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  white-space: pre-wrap;\r\n  user-select: text;\r\n  color: var(--text);\r\n}\r\n\r\n.history-view .diff-view.empty-diff {\r\n  align-items: stretch;\r\n  justify-content: flex-start;\r\n  text-align: left;\r\n}\r\n\r\n.history-body {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  min-height: 0;\r\n}\r\n\r\n.commit-files {\r\n  flex: 0 0 280px;\r\n  border-right: 1px solid var(--border);\r\n  overflow-y: auto;\r\n  background: var(--bg-panel);\r\n}\r\n\r\n.commit-files-head {\r\n  padding: 8px 10px;\r\n  color: var(--text-muted);\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  background: var(--bg-panel);\r\n  border-bottom: 1px solid var(--border);\r\n  font-size: 12px;\r\n}\r\n\r\n.history-diff {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  min-width: 0;\r\n}\r\n\r\n/* ---------------------------------------------------------------- chrome bits */\r\n\r\n/* -------------------------------------------------- integrated terminal */\r\n/* The docked terminal: a bar that matches the other pane headers, and one\r\n   host per open tab, sized by --term-h (set on .app, written straight during\r\n   the drag). xterm paints into .terminal-host; its own CSS comes from the\r\n   package. Only the active tab's host is laid out — the others stay mounted\r\n   so their shells survive a tab switch. */\r\n\r\n.resizer.resizer-horizontal {\r\n  flex: 0 0 5px;\r\n  margin: -3px 0;\r\n  cursor: row-resize;\r\n}\r\n\r\n.resizer.resizer-horizontal::after {\r\n  inset: 1px 0;\r\n}\r\n\r\nbody.desk-resizing.desk-resizing-row {\r\n  cursor: row-resize;\r\n}\r\n\r\n.terminal-panel {\r\n  flex: 0 0 var(--term-h, 260px);\r\n  min-height: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--bg);\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.terminal-bar {\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 14px;\r\n  padding: 3px 10px;\r\n  background: var(--bg-panel);\r\n  border-bottom: 1px solid var(--border-subtle);\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.terminal-title {\r\n  font-weight: 600;\r\n  color: var(--text);\r\n}\r\n\r\n.terminal-repo {\r\n  font-weight: 400;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.terminal-exit,\r\n.terminal-error {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.terminal-error {\r\n  color: var(--danger);\r\n}\r\n\r\n.terminal-actions {\r\n  margin-left: auto;\r\n  display: inline-flex;\r\n  gap: 8px;\r\n}\r\n\r\n/* The tabs, in the same segmented tab language as the clone dialog and the\r\n   desk switcher: the active tab owns the accent and a hairline underline. */\r\n.terminal-tabs {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  min-width: 0;\r\n  overflow-x: auto;\r\n}\r\n\r\n.terminal-tab {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  padding: 1px 2px 1px 6px;\r\n  border-bottom: 2px solid transparent;\r\n  color: var(--text-muted);\r\n  white-space: nowrap;\r\n}\r\n\r\n.terminal-tab:hover {\r\n  color: var(--text);\r\n}\r\n\r\n.terminal-tab.active {\r\n  color: var(--accent);\r\n  border-bottom-color: var(--accent);\r\n}\r\n\r\n.terminal-tab-label {\r\n  background: none;\r\n  border: none;\r\n  color: inherit;\r\n  cursor: pointer;\r\n  font: inherit;\r\n  font-weight: 600;\r\n  padding: 0;\r\n}\r\n\r\n/* The position in the strip, kept quiet so the shell label stays the lead. */\r\n.terminal-tab-index {\r\n  margin-left: 5px;\r\n  font-weight: 400;\r\n  opacity: 0.55;\r\n}\r\n\r\n.terminal-tab-close,\r\n.terminal-new {\r\n  background: none;\r\n  border: none;\r\n  border-radius: 4px;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  line-height: 1;\r\n  padding: 2px 5px;\r\n}\r\n\r\n.terminal-tab-close:hover,\r\n.terminal-new:hover {\r\n  background: var(--bg-hover);\r\n  color: var(--text);\r\n}\r\n\r\n.terminal-tab-close:hover {\r\n  color: var(--danger);\r\n}\r\n\r\n/* One row so several hosts share the width instead of stacking; the hidden\r\n   ones take no space at all, and xterm refits when one comes back. */\r\n.terminal-body {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  display: flex;\r\n}\r\n\r\n.terminal-host {\r\n  position: relative;\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  padding: 4px 0 0 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.terminal-host.terminal-host-hidden {\r\n  display: none;\r\n}\r\n\r\n.terminal-host .xterm {\r\n  height: 100%;\r\n}\r\n\r\n/* ----------------------------------------------------------- status bar */\r\n.status-bar {\r\n  position: relative;\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  gap: 14px;\r\n  align-items: center;\r\n  padding: 3px 10px;\r\n  border-top: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n/* The machine-thinking signal: the accent blue, with the ring riding the item's own\r\n   currentColor. The AI variant answers in Agent Violet, so the two kinds of\r\n   waiting — git working and the agent writing — look different. */\r\n.status-item.busy {\r\n  position: relative;\r\n  color: var(--accent);\r\n}\r\n\r\n.status-item.busy.ai {\r\n  color: var(--ai);\r\n}\r\n\r\n.status-item.busy::before {\r\n  content: '';\r\n  display: inline-block;\r\n  width: 8px;\r\n  height: 8px;\r\n  border: 2px solid color-mix(in srgb, currentColor 35%, transparent);\r\n  border-top-color: currentColor;\r\n  border-radius: 50%;\r\n  animation: spin 0.8s linear infinite;\r\n  margin-right: 5px;\r\n  vertical-align: -1px;\r\n}\r\n\r\n\r\n.status-item.right {\r\n  margin-left: auto;\r\n}\r\n\r\n/* ---------------------------------------------------------------- dialogs */\r\n\r\n.dialog-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: var(--scrim);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 100;\r\n}\r\n\r\n.dialog {\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  box-shadow: var(--shadow);\r\n  max-width: min(92vw, 640px);\r\n  max-height: 88vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.dialog-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  border-radius: 12px 12px 0 0;\r\n}\r\n\r\n.dialog-head h2 {\r\n  margin: 0;\r\n  font-size: 14px;\r\n  font-weight: 600;\r\n}\r\n\r\n.dialog-body {\r\n  padding: 14px 16px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.dialog-foot {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  padding: 12px 16px;\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.field-label {\r\n  font-weight: 600;\r\n}\r\n\r\n.field-hint {\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n/* The merge dialog's branch picker: a scrollable list of .popover-item rows\r\n   inside a dialog, mirroring how the branch popover renders branches. */\r\n.dialog-branch-list {\r\n  max-height: 260px;\r\n  overflow-y: auto;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 4px;\r\n  margin: 4px 0 10px;\r\n  background: var(--bg);\r\n}\r\n\r\n.settings-section {\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.settings-section h3 {\r\n  margin: 0 0 10px;\r\n  font-size: 13px;\r\n  border-bottom: 1px solid var(--border);\r\n  padding-bottom: 6px;\r\n}\r\n\r\n.check-row {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.check-row input {\r\n  width: auto;\r\n}\r\n\r\n.row {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n.test-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.test-row .ok {\r\n  color: var(--add-text);\r\n}\r\n\r\n.test-row .bad {\r\n  color: var(--danger);\r\n}\r\n\r\n.confirm-message {\r\n  white-space: pre-wrap;\r\n  margin: 0;\r\n}\r\n\r\n.busy-line {\r\n  color: var(--accent);\r\n}\r\n\r\n/* ------------------------------------------------- hosted accounts / clone tabs */\r\n\r\n/* The clone dialog's source tabs: the same segmented tab language as the\r\n   desk switcher — the active tab owns the accent and a hairline underline. */\r\n.clone-tabs {\r\n  display: flex;\r\n  gap: 2px;\r\n  border-bottom: 1px solid var(--border);\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.clone-tab {\r\n  background: none;\r\n  border: none;\r\n  border-bottom: 2px solid transparent;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  font-size: 12.5px;\r\n  font-weight: 600;\r\n  padding: 6px 10px 5px;\r\n  margin-bottom: -1px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.clone-tab:hover {\r\n  color: var(--text);\r\n}\r\n\r\n.clone-tab.active {\r\n  color: var(--accent);\r\n  border-bottom-color: var(--accent);\r\n}\r\n\r\n.remote-pane {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.remote-toolbar {\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n}\r\n\r\n.remote-search {\r\n  flex: 1 1 auto;\r\n}\r\n\r\n/* All / Public / Private visibility chips in the remote-repo toolbar. */\r\n.repo-filter-chips {\r\n  flex: 0 0 auto;\r\n  display: flex;\r\n  gap: 4px;\r\n}\r\n\r\n.chip-toggle {\r\n  font: inherit;\r\n  font-size: 11px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  background: var(--bg);\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n  padding: 2px 9px;\r\n}\r\n\r\n.chip-toggle:hover {\r\n  background: var(--bg-hover);\r\n  color: var(--text);\r\n}\r\n\r\n.chip-toggle.active {\r\n  background: var(--bg-selected);\r\n  border-color: var(--accent);\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n\r\n.remote-sort {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.remote-list {\r\n  max-height: 260px;\r\n  overflow-y: auto;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 4px;\r\n  background: var(--bg);\r\n}\r\n\r\n.remote-repo {\r\n  display: flex;\r\n  width: 100%;\r\n  gap: 8px;\r\n  align-items: center;\r\n  background: none;\r\n  border: none;\r\n  border-radius: 6px;\r\n  color: var(--text);\r\n  cursor: pointer;\r\n  font: inherit;\r\n  text-align: left;\r\n  padding: 5px 8px;\r\n}\r\n\r\n.remote-repo:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n/* Picked rides the app's own accent selection surface, inverted per theme,\r\n   exactly like the file/commit/stash rows. */\r\n.remote-repo.picked {\r\n  background: var(--bg-selected);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.remote-repo.picked:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.remote-repo.picked .remote-repo-owner,\r\n.remote-repo.picked .remote-repo-time {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n.remote-repo.picked .repo-badge {\r\n  color: var(--row-on-accent);\r\n  background: var(--on-accent-chip);\r\n  border-color: var(--on-accent-chip-border);\r\n}\r\n\r\n.remote-repo-name {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.remote-repo-owner {\r\n  color: var(--text-muted);\r\n}\r\n\r\n.remote-repo-time {\r\n  flex: 0 0 auto;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.remote-empty,\r\n.remote-error,\r\n.remote-loading {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  margin: 4px 0;\r\n}\r\n\r\n.remote-error {\r\n  color: var(--danger);\r\n}\r\n\r\n.accounts-empty {\r\n  color: var(--text-muted);\r\n  font-size: 12.5px;\r\n}\r\n\r\n.account-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.account-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 8px 10px;\r\n  background: var(--bg-header);\r\n}\r\n\r\n.account-avatar {\r\n  flex: 0 0 auto;\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 50%;\r\n  background: var(--bg-inset);\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 700;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n/* The real avatar (main-proxied data: URL) rides the same circle as the\r\n   initials fallback. */\r\nimg.account-avatar {\r\n  object-fit: cover;\r\n}\r\n\r\n.account-who {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.account-name {\r\n  font-weight: 600;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.account-sub {\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n}\r\n\r\n.account-chip {\r\n  flex: 0 0 auto;\r\n  font-size: 10.5px;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  border-radius: 999px;\r\n  padding: 1px 6px;\r\n  border: 1px solid var(--border);\r\n  color: var(--text-muted);\r\n  background: var(--bg);\r\n}\r\n\r\n.mini.danger {\r\n  color: var(--danger);\r\n}\r\n\r\n.signin-panel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.signin-browser {\r\n  display: flex;\r\n  gap: 8px;\r\n}\r\n\r\n/* First-run OAuth-app setup, opened in place by a browser sign-in button:\r\n   the callback URL to type (selectable + copyable, because one wrong\r\n   character silently loses the redirect), the registration steps, and one\r\n   paste box. Role tokens only, so every community palette re-inks it. */\r\n.signin-setup {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  padding: 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n}\r\n\r\n.signin-setup-lede {\r\n  font-size: 12.5px;\r\n  margin: 0;\r\n}\r\n\r\n.signin-setup-callback {\r\n  display: flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.signin-setup-callback code {\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  padding: 3px 8px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  background: var(--bg-inset);\r\n  user-select: all;\r\n}\r\n\r\n.signin-setup-steps {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 3px;\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.signin-setup-id {\r\n  flex: 1 1 auto;\r\n  width: auto; /* the global 100% would eat the row and push Save out */\r\n}\r\n\r\n.signin-token {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.signin-provider {\r\n  flex: 0 0 auto;\r\n  width: auto; /* the global 100% would eat the row and push Sign in out */\r\n}\r\n\r\n.signin-token-input {\r\n  flex: 1 1 auto;\r\n}\r\n\r\n.signin-instance {\r\n  width: 100%;\r\n}\r\n\r\n.signin-error {\r\n  color: var(--danger);\r\n  font-size: 12px;\r\n  margin: 0;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n.signin-notice {\r\n  color: var(--add-text);\r\n  font-size: 12px;\r\n  margin: 0;\r\n}\r\n\r\n.signin-progress {\r\n  border: 1px solid var(--border);\r\n  border-radius: 8px;\r\n  padding: 10px;\r\n  background: var(--bg-header);\r\n}\r\n\r\n.signin-progress-line {\r\n  margin: 0 0 6px;\r\n}\r\n\r\n.signin-code-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.signin-code {\r\n  font-family: var(--mono);\r\n  font-size: 20px;\r\n  font-weight: 700;\r\n  letter-spacing: 0.12em;\r\n  padding: 4px 12px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  background: var(--bg);\r\n  user-select: all;\r\n}\r\n\r\n.signin-waiting {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  color: var(--text-muted);\r\n  font-size: 12.5px;\r\n  margin: 0 0 4px;\r\n}\r\n\r\n.signin-apps {\r\n  margin-top: 10px;\r\n}\r\n\r\n.signin-apps summary {\r\n  cursor: pointer;\r\n  color: var(--text-muted);\r\n  font-size: 12.5px;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.signin-apps .field {\r\n  margin-top: 8px;\r\n}\r\n\r\n/* ------------------------------------------------------- preferences two-pane */\r\n\r\n/* Preferences: sections on a panel-toned rail, one section's fields in the\r\n   pane — GitHub Desktop's own preferences shape, drawn in this app's\r\n   selection grammar: hover wash on the rows, solid accent + white label on\r\n   the active one. The body stops scrolling for itself; the pane owns scroll\r\n   so the rail never shifts under the pointer. */\r\n\r\n.dialog-body.settings-body {\r\n  padding: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.settings-shell {\r\n  display: flex;\r\n  align-items: stretch;\r\n  height: clamp(380px, 56vh, 560px);\r\n}\r\n\r\n.settings-nav {\r\n  flex: 0 0 184px;\r\n  background: var(--bg-panel);\r\n  border-right: 1px solid var(--border);\r\n  padding: 10px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.settings-nav-item {\r\n  display: block;\r\n  width: 100%;\r\n  text-align: left;\r\n  font: inherit;\r\n  color: var(--text);\r\n  background: none;\r\n  border: 1px solid transparent;\r\n  border-radius: 6px;\r\n  padding: 7px 9px;\r\n  cursor: pointer;\r\n  transition:\r\n    background-color var(--motion-instant) ease-out,\r\n    color var(--motion-instant) ease-out,\r\n    box-shadow var(--motion-instant) ease-out;\r\n}\r\n\r\n.settings-nav-item:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.settings-nav-item .nav-label {\r\n  display: block;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n}\r\n\r\n.settings-nav-item .nav-sub {\r\n  display: block;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n  margin-top: 1px;\r\n}\r\n\r\n.settings-nav-item.active {\r\n  background: var(--bg-selected);\r\n}\r\n\r\n.settings-nav-item.active:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.settings-nav-item.active .nav-label {\r\n  color: var(--on-accent);\r\n}\r\n\r\n.settings-nav-item.active .nav-sub {\r\n  color: color-mix(in srgb, var(--on-accent) 82%, transparent);\r\n}\r\n\r\n.settings-nav-item:focus-visible {\r\n  outline: none;\r\n  border-color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\n.settings-pane {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden auto; /* vertical scroll without a horizontal track */\r\n  padding: 14px 16px;\r\n  outline: none;\r\n}\r\n\r\n/* The rail swap: an opacity fade only, the desk switch's own register. */\r\n.settings-pane > section {\r\n  margin-bottom: 0;\r\n  animation: section-in var(--motion-fast) ease-out both;\r\n}\r\n\r\n@keyframes section-in {\r\n  from {\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n/* Info dot + tooltip: the visible hint carries what the field needs; the\r\n   dot carries the deeper story (registration steps, scopes, privacy notes)\r\n   on hover or keyboard focus. Bubble in the popover family: canvas face,\r\n   hairline, Float shadow, fade at a hair of scale. */\r\n\r\n.info-tip {\r\n  position: relative;\r\n  display: inline-flex;\r\n  vertical-align: baseline;\r\n}\r\n\r\n.info-dot {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 16px;\r\n  height: 16px;\r\n  padding: 0;\r\n  margin-left: 3px;\r\n  border: none;\r\n  border-radius: 999px;\r\n  background: none;\r\n  color: var(--text-muted);\r\n  cursor: pointer;\r\n  transition:\r\n    color var(--motion-instant) ease-out,\r\n    background-color var(--motion-instant) ease-out,\r\n    box-shadow var(--motion-instant) ease-out;\r\n}\r\n\r\n.info-dot:hover {\r\n  color: var(--accent);\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.info-dot:focus-visible {\r\n  outline: none;\r\n  color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\n.info-dot svg {\r\n  display: block;\r\n}\r\n\r\n.info-tip .tip-bubble {\r\n  position: absolute;\r\n  top: calc(100% + 6px);\r\n  left: -8px;\r\n  z-index: 12;\r\n  width: max-content;\r\n  max-width: min(300px, 70vw);\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  box-shadow: var(--shadow);\r\n  padding: 8px 10px;\r\n  font-size: 11.5px;\r\n  font-weight: 400;\r\n  line-height: 1.5;\r\n  color: var(--text);\r\n  white-space: pre-line;\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  transform: scale(0.98);\r\n  transition:\r\n    opacity var(--motion-fast) ease-out,\r\n    transform var(--motion-fast) var(--ease-arrive),\r\n    visibility var(--motion-fast);\r\n  pointer-events: none;\r\n}\r\n\r\n.info-tip:hover .tip-bubble,\r\n.info-tip:focus-within .tip-bubble {\r\n  opacity: 1;\r\n  visibility: visible;\r\n  transform: none;\r\n}\r\n\r\n/* ---------------------------------------------------------------- empty state / toasts */\r\n\r\n.empty-state {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n}\r\n\r\n.onboarding {\r\n  max-width: 460px;\r\n  text-align: center;\r\n}\r\n\r\n.onboarding h1 {\r\n  /* GitHub's own register for this line: a plain semibold heading, not a\r\n     display moment. */\r\n  font-size: 22px;\r\n  font-weight: 600;\r\n  margin: 0 0 8px;\r\n  color: var(--text);\r\n}\r\n\r\n.onboarding p {\r\n  color: var(--text-muted);\r\n  line-height: 1.5;\r\n}\r\n\r\n.onboarding-actions {\r\n  display: flex;\r\n  gap: 10px;\r\n  justify-content: center;\r\n  margin: 18px 0 14px;\r\n}\r\n\r\n.toasts {\r\n  position: fixed;\r\n  bottom: 40px;\r\n  right: 14px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  z-index: 200;\r\n  max-width: 420px;\r\n}\r\n\r\n.toast {\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  padding: 9px 12px;\r\n  box-shadow: var(--shadow);\r\n  white-space: pre-wrap;\r\n  user-select: text;\r\n  font-size: 12.5px;\r\n}\r\n\r\n/* GitHub's banners: the whole card takes the state's subtle ground and the\r\n   label takes its strong tone, so severity reads at a glance and the color\r\n   pairing is GitHub's own, never gray text on a colored field. */\r\n.toast.error {\r\n  background: var(--del-bg);\r\n  border-color: color-mix(in srgb, var(--danger) 35%, var(--border));\r\n  color: var(--del-text);\r\n}\r\n\r\n.toast.success {\r\n  background: var(--add-bg);\r\n  border-color: color-mix(in srgb, var(--success) 35%, var(--border));\r\n  color: var(--add-text);\r\n}\r\n\r\n.toast.info {\r\n  background: var(--hunk-bg);\r\n  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));\r\n  color: var(--hunk-text);\r\n}\r\n\r\n.toast .btn {\r\n  background: var(--bg);\r\n}\r\n\r\n::-webkit-scrollbar {\r\n  width: 10px;\r\n  height: 10px;\r\n}\r\n\r\n/* The scrollbar is GitHub's neutral thumb: present when you scroll, invisible\r\n   when you are reading. */\r\n::-webkit-scrollbar-thumb {\r\n  background: var(--scroll-thumb);\r\n  border-radius: 6px;\r\n}\r\n\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: var(--scroll-thumb-hover);\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n  background: transparent;\r\n}\r\n\r\n/* -------------------------------------------------- word-level diff spans */\r\n\r\n.content .word-ins {\r\n  background: var(--word-add);\r\n  border-radius: 2px;\r\n}\r\n\r\n.content .word-del {\r\n  background: var(--word-del);\r\n  border-radius: 2px;\r\n  text-decoration: line-through;\r\n  text-decoration-color: var(--word-del-strike);\r\n}\r\n\r\n/* ------------------------------------------------------ split diff view */\r\n\r\n.diff-view.nowrap .content {\r\n  white-space: pre;\r\n  word-break: normal;\r\n}\r\n\r\n.diff-table.split {\r\n  table-layout: fixed;\r\n}\r\n\r\n.diff-table.split .content.side {\r\n  width: calc(50% - 48px);\r\n  max-width: calc(50% - 48px);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.diff-table.split .content.side.left {\r\n  border-right: 1px solid var(--border);\r\n}\r\n\r\n.diff-table.split .content.side.empty {\r\n  background: var(--bg-panel);\r\n  opacity: 0.55;\r\n}\r\n\r\n.diff-table.split .content.side.left.del {\r\n  background: var(--del-bg);\r\n}\r\n\r\n.diff-table.split .content.side.right.add {\r\n  background: var(--add-bg);\r\n}\r\n\r\n.diff-truncated {\r\n  padding: 10px 14px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  border-top: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  position: sticky;\r\n  bottom: 0;\r\n}\r\n\r\n.diff-title {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 10px;\r\n}\r\n\r\n.diff-title-path {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.diff-title-actions {\r\n  display: flex;\r\n  gap: 4px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.diff-error {\r\n  color: var(--danger);\r\n  user-select: text;\r\n  white-space: pre-wrap;\r\n}\r\n\r\n/* --------------------------------------------------------- media preview */\r\n\r\n/*\r\n * The panel that replaces the \"Binary file\" state for image/video/audio\r\n * files (components/DiffView.tsx, MediaPreview). The stage is inset so the\r\n * media reads as a viewer, not as page canvas; transparent images keep the\r\n * theme's own inset tone behind them.\r\n */\r\n.media-preview-view {\r\n  overflow: hidden;\r\n}\r\n\r\n.media-preview {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 10px;\r\n  padding: 20px;\r\n  overflow: auto;\r\n  background: var(--bg-inset);\r\n}\r\n\r\n.media-preview img,\r\n.media-preview video {\r\n  max-width: 100%;\r\n  max-height: 100%;\r\n  object-fit: contain;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n}\r\n\r\n.media-preview audio {\r\n  width: min(480px, 100%);\r\n}\r\n\r\n.media-caption {\r\n  font-size: 12px;\r\n}\r\n\r\n/* ------------------------------------------------------------- 3D models */\r\n\r\n/*\r\n * The WebGL stage inside the media panel (components/ModelPreview.tsx). The\r\n * canvas owns the panel — a model needs the whole diff pane to be legible — so\r\n * the toggles float over it and the loading/error notes are centered on it. The\r\n * stage keeps its own inset gradient: a flat theme background behind a shaded\r\n * model reads as a rendering error.\r\n */\r\n.model-preview {\r\n  position: relative;\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  width: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.model-stage {\r\n  position: relative;\r\n  flex: 1 1 auto;\r\n  min-height: 320px;\r\n  overflow: hidden;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  background: radial-gradient(circle at 50% 36%, var(--bg-panel), var(--bg-inset) 82%);\r\n}\r\n\r\n.model-stage canvas {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  outline: none;\r\n  cursor: grab;\r\n  /* OrbitControls handles the pointer; without this, a drag pans the pane. */\r\n  touch-action: none;\r\n}\r\n\r\n.model-stage canvas:active {\r\n  cursor: grabbing;\r\n}\r\n\r\n.model-stage canvas:focus-visible {\r\n  box-shadow: inset var(--focus-ring);\r\n}\r\n\r\n.model-toolbar {\r\n  position: absolute;\r\n  top: 8px;\r\n  left: 8px;\r\n  display: flex;\r\n  gap: 2px;\r\n  padding: 2px 4px;\r\n  border: 1px solid var(--btn-border);\r\n  border-radius: 6px;\r\n  background: var(--chip-face);\r\n}\r\n\r\n.model-toolbar .mini:disabled {\r\n  color: var(--btn-disabled-ink);\r\n  cursor: default;\r\n  text-decoration: none;\r\n}\r\n\r\n.model-toolbar .mini[aria-pressed='true'] {\r\n  color: var(--text);\r\n  background: var(--bg-hover);\r\n  border-radius: 4px;\r\n  text-decoration: none;\r\n}\r\n\r\n.model-note,\r\n.model-error {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: grid;\r\n  place-content: center;\r\n  gap: 6px;\r\n  text-align: center;\r\n  pointer-events: none;\r\n}\r\n\r\n.model-error .btn {\r\n  justify-self: center;\r\n  pointer-events: auto;\r\n}\r\n\r\n.model-error p {\r\n  margin: 0;\r\n}\r\n\r\n/* -------------------------------------------------------- context menu */\r\n\r\n.context-menu {\r\n  position: fixed;\r\n  /* The title-band menus render inside .titlebar, whose -webkit-app-region:\r\n     drag would swallow every pointer event on the open dropdown (Electron\r\n     treats descendants as drag too unless they opt out). Without this the\r\n     File/Edit/View menus open but no item can be clicked. Outside a drag\r\n     region the declaration is a no-op, so right-click menus are unaffected. */\r\n  -webkit-app-region: no-drag;\r\n  z-index: 300;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px;\r\n  box-shadow: var(--shadow);\r\n  padding: 4px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  max-width: 320px;\r\n}\r\n\r\n.context-menu .popover-item {\r\n  border-radius: 6px;\r\n}\r\n\r\n/* Long menus (the Ignore submenu's parent list) scroll instead of running\r\n   off the bottom; nested submenus are fixed-position and unaffected. */\r\n.context-menu {\r\n  max-height: 80vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* Side panel of a one-level submenu (.context-menu gives it the shared\r\n   surface; it stacks above the parent and positions from the viewport). */\r\n.context-submenu {\r\n  z-index: 301;\r\n  max-height: 80vh;\r\n  overflow-y: auto;\r\n}\r\n\r\n/* Group heading inside a context menu — a label, not an action. */\r\n.menu-heading {\r\n  color: var(--text-muted);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  padding: 6px 10px 2px;\r\n}\r\n\r\n/* ------------------------------------------------------- workflow banner */\r\n\r\n.workflow-banner {\r\n  margin: 8px 10px;\r\n  padding: 9px 11px;\r\n  border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));\r\n  background: var(--hunk-bg);\r\n  border-radius: 6px;\r\n  font-size: 12px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 7px;\r\n}\r\n\r\n.workflow-banner.warning {\r\n  border-color: color-mix(in srgb, var(--caution) 55%, var(--border));\r\n  background: color-mix(in srgb, var(--caution) 12%, var(--bg-panel));\r\n}\r\n\r\n.workflow-actions {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.identity-form {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.identity-form input {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n.conflict-actions {\r\n  display: flex;\r\n  gap: 3px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.mini.danger {\r\n  color: var(--danger);\r\n}\r\n\r\n/* -------------------------------------------------------- attention dialog */\r\n\r\n/* The conflicted-file list inside the attention dialog: repo paths in the\r\n   mono stack (verbatim text stays verbatim), each row carrying the same\r\n   quick resolves the file rows use. Hairline-separated 6px card, matching\r\n   the banner family rather than inventing a new one. */\r\n.attention-files {\r\n  list-style: none;\r\n  margin: 10px 0 0;\r\n  padding: 0;\r\n  max-height: 280px;\r\n  overflow-y: auto;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n}\r\n\r\n.attention-file {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 6px 10px;\r\n}\r\n\r\n.attention-file + .attention-file {\r\n  border-top: 1px solid var(--border);\r\n}\r\n\r\n.attention-file-path {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  text-align: left;\r\n  cursor: pointer;\r\n  font-family: var(--mono);\r\n  font-size: 12px;\r\n  color: var(--text);\r\n}\r\n\r\n.attention-file-path:hover {\r\n  color: var(--accent);\r\n}\r\n\r\n/* --------------------------------------------------------------- stash */\r\n\r\n.stash-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 5px 10px;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n  border-bottom: 1px solid transparent;\r\n}\r\n\r\n.stash-row:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n.stash-row.selected {\r\n  background: var(--bg-selected);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.stash-row.selected:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.stash-row.selected .file-dir {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n/* The message and the row's own verbs ride the row's white: the red Drop verb\r\n   would be illegible painted straight onto the accent. */\r\n.stash-row.selected .stash-message {\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.stash-row.selected .mini,\r\n.file-row.selected .mini,\r\n.commit-row.selected .mini {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n.stash-row.selected .mini:hover,\r\n.file-row.selected .mini:hover,\r\n.commit-row.selected .mini:hover {\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.stash-detail {\r\n  flex: 1 1 auto;\r\n  padding: 16px;\r\n  max-width: 640px;\r\n}\r\n\r\n/* A stash is parked work, not a state of the worktree: it is named in plain\r\n   ink, and only its verbs carry color. */\r\n.stash-detail-head {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 10px;\r\n  font-size: 14px;\r\n  color: var(--text);\r\n}\r\n\r\n.stash-detail-head code {\r\n  font-family: var(--mono);\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  padding: 0 4px;\r\n}\r\n\r\n.stash-detail-meta {\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  margin-top: 4px;\r\n}\r\n\r\n/* The stash commit's message body, as stored (multi-line, plain text). */\r\n.stash-detail-description {\r\n  margin-top: 10px;\r\n  font-size: 13px;\r\n  line-height: 1.55;\r\n  user-select: text;\r\n}\r\n\r\n.stash-detail-note {\r\n  margin-top: 12px;\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n  line-height: 1.5;\r\n  user-select: text;\r\n}\r\n\r\n.resolve-help {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  font-size: 12.5px;\r\n  line-height: 1.5;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.resolve-help strong {\r\n  color: var(--text);\r\n}\r\n\r\n.resolve-help b {\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n\r\n.resolve-help p {\r\n  margin: 0;\r\n  user-select: text;\r\n}\r\n\r\n.resolve-help .btn {\r\n  font-size: 12.5px;\r\n}\r\n\r\n/* ------------------------------------------------------- AI merge agent */\r\n\r\n/* The same machine as ✨ Generate, speaking in Agent Violet from the row. */\r\n.mini.ai {\r\n  color: var(--ai);\r\n  font-variant-emoji: text;\r\n}\r\n\r\n.mini.ai:disabled {\r\n  color: var(--text-muted);\r\n  cursor: default;\r\n  text-decoration: none;\r\n}\r\n\r\n.mini.ai:disabled:hover {\r\n  text-decoration: none;\r\n}\r\n\r\n.merge-questions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.merge-questions .field-label {\r\n  color: var(--text);\r\n}\r\n\r\n/* One-click suggested answers; picking one only fills the box below it, so\r\n   a short answer stays a tap and a long one stays a sentence. */\r\n.merge-options {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n}\r\n\r\n.merge-option {\r\n  border: 1px solid var(--border);\r\n  border-radius: 999px;\r\n  color: var(--text-muted);\r\n  font-size: 12px;\r\n  padding: 3px 10px;\r\n}\r\n\r\n.merge-option:hover:not(:disabled) {\r\n  border-color: color-mix(in srgb, var(--ai) 45%, var(--border));\r\n  color: var(--text);\r\n  text-decoration: none;\r\n}\r\n\r\n.merge-option.active {\r\n  background: var(--ai);\r\n  border-color: var(--ai);\r\n  color: var(--on-accent);\r\n}\r\n\r\n.merge-option.active:hover:not(:disabled) {\r\n  text-decoration: none;\r\n}\r\n\r\n.merge-thinking {\r\n  align-items: center;\r\n  color: var(--ai);\r\n  display: inline-flex;\r\n  gap: 6px;\r\n  margin: 0;\r\n}\r\n\r\n.merge-error {\r\n  color: var(--danger);\r\n}\r\n\r\n.stash-message {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ------------------------------------------------------- commit box extras */\r\n\r\n.amend-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  font-size: 11.5px;\r\n  color: var(--text-muted);\r\n  background: color-mix(in srgb, var(--accent) 12%, var(--bg-panel));\r\n  border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));\r\n  border-radius: 6px;\r\n  padding: 5px 8px;\r\n  margin-bottom: 7px;\r\n}\r\n\r\n.amend-bar code {\r\n  font-family: var(--mono);\r\n}\r\n\r\n.changes-toolbar-actions {\r\n  display: flex;\r\n  gap: 4px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.history-filters {\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n  gap: 6px;\r\n}\r\n\r\n.filter-input {\r\n  width: 100%;\r\n  font-size: 12px;\r\n}\r\n\r\n.load-more {\r\n  margin: 8px 10px;\r\n}\r\n\r\n/* ------------------------------------------------------------- popovers */\r\n\r\n.popover-heading {\r\n  padding: 6px 10px 2px;\r\n  font-size: 10.5px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--text-muted);\r\n}\r\n\r\n.popover-item-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n}\r\n\r\n.popover-item-row .popover-item {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n.popover-item-actions {\r\n  display: none;\r\n  gap: 3px;\r\n  padding-right: 6px;\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.popover-item-row:hover .popover-item-actions {\r\n  display: inline-flex;\r\n}\r\n\r\n/* ------------------------------------------------------------ app chrome */\r\n\r\n.toast-text {\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.repo-dirty.clean {\r\n  color: var(--text-muted, #57606a);\r\n}\r\n\r\n.app-banner {\r\n  padding: 8px 14px;\r\n  font-size: 12.5px;\r\n  /* A GitHub banner: the state's own subtle ground, its strong tone for the\r\n     text, and no gray label floating on a colored field. */\r\n  background: var(--del-bg);\r\n  border-bottom: 1px solid color-mix(in srgb, var(--danger) 35%, var(--border));\r\n  color: var(--del-text);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.recent-repos {\r\n  margin-top: 22px;\r\n  width: min(420px, 90%);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  text-align: left;\r\n}\r\n\r\n.recent-repos h2 {\r\n  font-size: 12px;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--text-muted);\r\n  margin: 0 0 2px;\r\n}\r\n\r\n.recent-repo {\r\n  display: flex;\r\n  align-items: baseline;\r\n  gap: 8px;\r\n  padding: 8px 10px;\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  background: var(--bg-panel);\r\n  color: var(--text);\r\n  font: inherit;\r\n  cursor: pointer;\r\n  text-align: left;\r\n}\r\n\r\n.recent-repo:hover {\r\n  background: var(--bg-hover);\r\n  border-color: var(--btn-border-hover);\r\n}\r\n\r\n.recent-repo small {\r\n  color: var(--text-muted);\r\n  font-family: var(--mono);\r\n  font-size: 11px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.onboarding-links {\r\n  display: flex;\r\n  gap: 14px;\r\n  margin-top: 18px;\r\n  flex-wrap: wrap;\r\n  justify-content: center;\r\n}\r\n\r\n.shortcut-list {\r\n  margin: 0;\r\n  padding-left: 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n  font-size: 12.5px;\r\n  color: var(--text-muted);\r\n  user-select: text;\r\n}\r\n\r\n.shortcut-list code,\r\n.confirm-message code,\r\n.repo-manager-foot-hint code {\r\n  font-family: var(--mono);\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  padding: 0 4px;\r\n  font-size: 11.5px;\r\n  color: var(--text);\r\n}\r\n\r\n/* ---------------------------------------------------- commit action rows */\r\n\r\n.commit-actions-inline {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n  margin-left: auto;\r\n}\r\n\r\n.muted {\r\n  color: var(--text-muted);\r\n}\r\n\r\n/* ------------------------------------------------------- donation section */\r\n\r\n.donate-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.donate-row small {\r\n  font-size: 11.5px;\r\n  user-select: text;\r\n}\r\n\r\n/* ---------------------------------------------------------- updates section */\r\n\r\n/* The About dialog's download meter: a track the width of the dialog body\r\n   with a Commit-Green fill, mirroring the token language everywhere else. */\r\n.update-progress {\r\n  height: 6px;\r\n  border-radius: 3px;\r\n  background: var(--bg-header);\r\n  border: 1px solid var(--border);\r\n  overflow: hidden;\r\n  margin: 0 0 10px;\r\n}\r\n\r\n.update-progress-fill {\r\n  height: 100%;\r\n  background: var(--success);\r\n  border-radius: 3px;\r\n  transition: width 0.4s ease;\r\n}\r\n\r\n.diff-line.split-row td {\r\n  border-bottom: 1px solid var(--border-subtle);\r\n}\r\n\r\n.file-row.compact {\r\n  padding: 3px 10px;\r\n  font-size: 12px;\r\n}\r\n\r\n/* ---------------------------------------------------------------- toasts */\r\n\r\n.toast {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 8px;\r\n}\r\n\r\n.toast-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n.toast-buttons {\r\n  display: flex;\r\n  gap: 6px;\r\n}\r\n\r\n.toast-close {\r\n  flex: 0 0 auto;\r\n  border: none;\r\n  background: none;\r\n  color: var(--text-muted);\r\n  font-size: 14px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n  padding: 0 2px;\r\n}\r\n\r\n.toast-close:hover {\r\n  color: var(--text);\r\n}\r\n\r\n/* ------------------------------------------------- repository manager */\r\n\r\n/* Machine-truth cells (branch names, ahead/behind counts) quote the\r\n   repository, so they take the mono voice. */\r\n.mono {\r\n  font-family: var(--mono);\r\n}\r\n\r\n.repo-manager-toolbar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.repo-manager-filter-wrap {\r\n  position: relative;\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  display: flex;\r\n}\r\n\r\n/* The hub's filter is a standing control, not a popover's transient one, so it\r\n   takes the shared input treatment at its own width. */\r\n.repo-manager-filter {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n/* The result count rides inside the filter's right edge like the strip's\r\n   Ctrl K chip, so it never nudges the neighbouring buttons. */\r\n.repo-manager-shown {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  font-family: var(--mono);\r\n  font-size: 10.5px;\r\n  color: var(--text-muted);\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  padding: 0 5px;\r\n  line-height: 16px;\r\n  pointer-events: none;\r\n  white-space: nowrap;\r\n}\r\n\r\n.repo-manager-filter.has-shown {\r\n  padding-right: 92px;\r\n}\r\n\r\n/* The machine-thinking signal, in the same accent blue as the status bar's. */\r\n.repo-manager-busy {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  color: var(--accent);\r\n  font-size: 11.5px;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* One quiet rail under the toolbar: the watch-folder state and its verbs. */\r\n.repo-scan-bar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.repo-scan-note {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  color: var(--text-muted);\r\n  font-size: 11.5px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.repo-scan-path {\r\n  font-family: var(--mono);\r\n  color: var(--text);\r\n  direction: rtl;\r\n  unicode-bidi: plaintext;\r\n}\r\n\r\n/* Bulk actions exist only while a selection exists — no reserved dead row. */\r\n.repo-manager-selectbar {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n  row-gap: 6px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.repo-manager-count {\r\n  font-weight: 600;\r\n  margin-right: 4px;\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n}\r\n\r\n/* Names the one repository the Open verb takes when several are picked. */\r\n.btn-target {\r\n  color: var(--text-muted);\r\n  max-width: 104px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.repo-table {\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n  background: var(--bg-panel);\r\n  max-height: 46vh;\r\n  min-height: 240px;\r\n  overflow-y: auto;\r\n  outline: none;\r\n}\r\n\r\n.repo-table:focus-visible {\r\n  border-color: var(--accent);\r\n  box-shadow: var(--focus-ring);\r\n}\r\n\r\n/* Header and rows share one column grid so every label sits above its data. */\r\n.repo-table-head,\r\n.repo-manager-row,\r\n.repo-group-row {\r\n  display: grid;\r\n  grid-template-columns: 24px minmax(0, 1fr) 150px 92px 58px 96px 46px;\r\n  align-items: center;\r\n  column-gap: 12px;\r\n  padding: 0 10px;\r\n}\r\n\r\n/* The sticky header-surface bar of the diff title and changes-toolbar family;\r\n   the scroll box's own radius clips its corners. */\r\n.repo-table-head {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  min-height: 30px;\r\n  background: var(--bg-header);\r\n  border-bottom: 1px solid var(--border);\r\n  color: var(--text-muted);\r\n  font-size: 10.5px;\r\n  font-weight: 600;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n}\r\n\r\n.repo-table-head [role='columnheader'] {\r\n  min-width: 0;\r\n}\r\n\r\n.repo-sort {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  width: 100%;\r\n  padding: 2px 0;\r\n  border: none;\r\n  background: none;\r\n  color: inherit;\r\n  font: inherit;\r\n  font-size: 10.5px;\r\n  font-weight: inherit;\r\n  letter-spacing: inherit;\r\n  text-transform: inherit;\r\n  cursor: pointer;\r\n}\r\n\r\n.repo-sort.right {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.repo-sort:hover {\r\n  color: var(--text);\r\n}\r\n\r\n.repo-table-head [aria-sort='ascending'] .repo-sort,\r\n.repo-table-head [aria-sort='descending'] .repo-sort {\r\n  color: var(--text);\r\n}\r\n\r\n.repo-sort:focus-visible {\r\n  outline: 2px solid var(--accent);\r\n  outline-offset: 1px;\r\n  border-radius: 4px;\r\n}\r\n\r\n/* The sort caret is a glyph, not type: it stays on the 10.5px floor like the\r\n   header labels it rides with. */\r\n.repo-sort .caret {\r\n  line-height: 1;\r\n}\r\n\r\n.repo-manager-row {\r\n  padding: 7px 10px;\r\n  cursor: pointer;\r\n  user-select: none;\r\n  border-bottom: 1px solid var(--border-subtle);\r\n}\r\n\r\n.repo-manager-row:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.repo-manager-row:hover {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n/* Selection is GitHub's accent, and the row inverts to white on it exactly as\r\n   the queue's rows do; hover deepens the accent instead of washing it out. */\r\n.repo-manager-row.selected {\r\n  background: var(--bg-selected);\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.repo-manager-row.selected:hover {\r\n  background: var(--bg-selected-hover);\r\n}\r\n\r\n.repo-manager-row.selected .repo-path-dir,\r\n.repo-manager-row.selected .repo-cell {\r\n  color: var(--row-on-accent-muted);\r\n}\r\n\r\n.repo-manager-row.selected .repo-path-leaf,\r\n.repo-manager-row.selected .repo-name-text {\r\n  color: var(--row-on-accent);\r\n}\r\n\r\n.repo-manager-row.selected .badge,\r\n.repo-manager-row.selected .repo-badge {\r\n  color: var(--row-on-accent);\r\n  background: var(--on-accent-chip);\r\n  border-color: var(--on-accent-chip-border);\r\n}\r\n\r\n.repo-manager-row.selected input[type='checkbox'] {\r\n  accent-color: var(--on-accent);\r\n}\r\n\r\n/* Keyboard cursor: the accent border is the only active signal. */\r\n.repo-manager-row.cursor {\r\n  outline: 1px solid var(--accent);\r\n  outline-offset: -3px;\r\n  border-radius: 6px;\r\n}\r\n\r\n.repo-check-cell {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.repo-table-head input[type='checkbox'],\r\n.repo-check-cell input[type='checkbox'] {\r\n  width: auto;\r\n  accent-color: var(-