			let adds = 0;
			let dels = 0;
			for (const d of diffs) {
				for (const line of d.split("\n")) {
					if (line.startsWith("+") && !line.startsWith("+++")) adds += 1;
					else if (line.startsWith("-") && !line.startsWith("---")) dels += 1;
				}
			}
			this.update({
				scopeAdds: adds,
				scopeDels: dels,
				scopeLoading: false
			});
		} catch {
			if (token === this.scopeToken) this.update({ scopeLoading: false });
