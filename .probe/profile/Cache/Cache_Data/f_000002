		if (repo === null) return;
		const target = this.state.status?.branch ?? "(detached)";
		const source = fromRemote !== undefined && fromRemote.length > 0 ? `${fromRemote}/${name}` : name;
		this.update({
			busy: "merge",
			mergeBranchOpen: false
		});
